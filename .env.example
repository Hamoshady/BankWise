# Copy to .env (git-ignored) or set these in your shell. Never commit real values.

# development | production. If unset the application assumes production (fails closed).
BANKWISE_ENV=development

# Optional logging overrides (otherwise configs/logging.yaml is used)
# BANKWISE_LOG_LEVEL=INFO
# BANKWISE_LOG_FORMAT=json

# Secrets: leave empty here. Production needs >= 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BANKWISE_JWT_SECRET=
BANKWISE_PII_HMAC_KEY=
