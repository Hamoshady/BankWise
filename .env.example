# Copy to .env (git-ignored) or set these in your shell. Never commit real values.

# development | production. If unset the application assumes production (fails closed).
BANKWISE_ENV=development

# Optional logging overrides (otherwise configs/logging.yaml is used)
# BANKWISE_LOG_LEVEL=INFO
# BANKWISE_LOG_FORMAT=json

# Secrets: leave empty here. Production needs >= 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BANKWISE_JWT_SECRET=
BANKWISE_PII_HMAC_KEY=
# Key for the tamper-evident audit file. Different from the JWT secret, >= 32 random characters in production.
BANKWISE_AUDIT_HMAC_KEY=

# PostgreSQL URL for local API, CLI and Alembic. Must use postgresql+psycopg.
# Format: postgresql+psycopg://USERNAME:URL_ENCODED_PASSWORD@HOST:5432/DATABASE
BANKWISE_DATABASE_URL=
# Existing database: use a separately provisioned schema to avoid legacy table collisions.
# BANKWISE_DATABASE_SCHEMA=public
# BANKWISE_DATABASE_POOL_SIZE=5
# BANKWISE_DATABASE_POOL_TIMEOUT_SECONDS=5
# BANKWISE_DATABASE_CONNECT_TIMEOUT_SECONDS=5
# BANKWISE_DATABASE_RETENTION_DAYS=30

# Docker Compose PostgreSQL configuration. Use an URL-safe random password.
POSTGRES_USER=bankwise
POSTGRES_DB=bankwise
POSTGRES_PASSWORD=

# Local OCR: models must be installed before startup; no serving-time downloads.
BANKWISE_OCR_MODEL_DIR=
BANKWISE_OCR_USE_GPU=1
BANKWISE_OCR_ALLOW_CPU_FALLBACK=0
# Compose uses a CPU-only image explicitly; local CUDA installations are unchanged.
# BANKWISE_DOCKER_MODEL_DIR=./models

# Optional offline semantic retrieval and local LLM evidence selection
# BANKWISE_RAG_MODE=lexical
# BANKWISE_RAG_MODEL_DIR=/rag-models
# Optional pinned local llama.cpp backend; see docs/local_llm.md
# BANKWISE_LLAMA_URL=http://127.0.0.1:8081
# Local simulated banking only; disabled by default. Never connects to real funds.
BANKWISE_BANKING_MODE=disabled

# Two-factor login OTP delivery. Production requires an HTTPS webhook and an API key;
# in development, leaving BANKWISE_SMS_URL unset selects the in-memory mock SMS provider.
# The gateway must accept POST JSON: {"to": "+20...", "message": "...", "reference": "<opaque id>"}
# BANKWISE_SMS_URL=https://sms-gateway.example.local/api/messages
# BANKWISE_SMS_API_KEY=
